<script>
  const toggle = document.getElementById('themeToggle');
  function updateTheme(th) {
    document.documentElement.setAttribute('data-bs-theme', th);
    document.querySelectorAll('.theme-logo').forEach(el => {
      el.src = th === 'dark' ? el.dataset.darkSrc : el.dataset.lightSrc;
    });
    toggle.innerHTML = th === 'dark' ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon"></i>';
    localStorage.setItem('theme', th);
  }
  toggle?.addEventListener('click', () => {
    const cur = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
    updateTheme(cur);
  });
  updateTheme(localStorage.getItem('theme') || 'light');
</script>
